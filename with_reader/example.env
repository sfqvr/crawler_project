# =============================================
# Пример файла .env (example.env)
# =============================================

# === Основные настройки ReaderLM (локально) ===
READER_BASE_URL=http://localhost:1234/v1
READER_API_KEY=lm-studio
READER_MODEL=readerlm-v2
# READER_MODEL=reader-lm-1.5b

# === Настройки удалённого агента (DeepSeek / OpenRouter) ===
AGENT_BASE_URL=https://routerai.ru/api/v1
# AGENT_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AGENT_MODEL=deepseek/deepseek-v4-flash

# Какой backend использовать по умолчанию: reader | agent
STAGE5_BACKEND=reader

# === OpenAI-совместимые настройки ===
OPENAI_BASE_URL=https://routerai.ru/api/v1
# OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=deepseek/deepseek-v4-flash
OPENAI_EMBEDDING_MODEL=baai/bge-m3

# === Tavily (поиск) ===
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === Anthropic, Google и др. (если нужно) ===
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# === Qdrant (векторная БД) ===
QDRANT_LOCAL_MODE=true
QDRANT_LOCAL_PATH=qdrant_local_data
QDRANT_COLLECTION=incident_documents
EMBEDDING_BATCH_SIZE=8
UPSERT_BATCH_SIZE=32
RECREATE_COLLECTION=false

# === Ограничения ===
MAX_HTML_CHARS_FOR_LLM=320000

# === PostgreSQL (Prefect) ===
# POSTGRES_DB=prefect_sql2
# POSTGRES_USER=...
# POSTGRES_PASSWORD=...